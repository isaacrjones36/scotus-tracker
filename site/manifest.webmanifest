{
  "name": "SCOTUS Tracker",
  "short_name": "SCOTUS",
  "description": "The Supreme Court's docket, argument calendar, decisions, justices and stats.",
  "start_url": "./#overview",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f3f4f1",
